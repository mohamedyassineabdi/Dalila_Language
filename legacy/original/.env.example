# Local is the default; no key required.
OLLAMA_URL=http://127.0.0.1:11434
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
HF_TOKEN=
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
TTS_DEVICE=cpu
# Set to 4bit for CUDA TounsiLM if needed; otherwise bf16 (CUDA) / fp32 (CPU)
TOUNSI_PRECISION=4bit
# Optional absolute path to separate voice Python executable
VOICE_PYTHON=
